{
    "name":  "play-js-cucumber",
    "version":  "1.0.0",
    "description":  "Playwright Cucumber JavaScript framework",
    "main":  "index.js",
    "scripts":  {
                    "pretest":  "node src/helper/report/init.js",
                    "test":  "cucumber-js --config=config/cucumber.js",
                    "posttest":  "node src/helper/report/report.js",
                    "test:failed":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js -p rerun @rerun.txt",
                    "test:all":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js",
                    "test:smoke":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @smoke",
                    "test:regression":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @regression",
                    "test:staging":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js",
                    "test:sanity":  "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @sanity",
                    "test:smoke1":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @smoke1",
                    "test:api":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @api",
                    "test:api:chain":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @chain",
                    "test:key":  "cross-env ENV=STG node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js",
                    "test:key:prd":  "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js",
                    "allure:generate":  "allure generate allure-results --clean -o allure-report",
                    "allure:open":  "allure open allure-report",
                    "allure:serve":  "allure serve allure-results"
                },
    "keywords":  [
                     "cucumber",
                     "cucumber-js",
                     "playwright-cucumber"
                 ],
    "author":  "Continental QA",
    "license":  "ISC",
    "devDependencies":  {
                            "@cucumber/cucumber":  "^9.0.1",
                            "@playwright/test":  "1.35.0",
                            "allure-commandline":  "^2.34.1",
                            "allure-cucumberjs":  "2.15.1",
                            "allure-js-commons":  "^2.15.1",
                            "ajv":  "^8.17.1",
                            "cross-env":  "^7.0.3",
                            "dotenv":  "^16.0.3",
                            "fs-extra":  "^11.1.1",
                            "multiple-cucumber-html-reporter":  "^3.3.0",
                            "winston":  "^3.8.2"
                        },
    "dependencies":  {
                         "csv-parse":  "^6.1.0",
                         "xlsx":  "^0.18.5"
                     }
}
