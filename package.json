{
  "name": "play-ts-cucumber",
  "version": "1.0.0",
  "description": "Playwright Cucumber TS framework - The easiest way to learn",
  "main": "index.js",
 "scripts": {
  "pretest": "npx ts-node src/helper/report/init.ts",
  "test": "cucumber-js --config=config/cucumber.js || true",
  "posttest": "npx ts-node src/helper/report/report.ts",
  "test:failed": "cucumber-js -p rerun @rerun.txt",
  "test:all": "cross-env ENV=staging cucumber-js --config=config/cucumber.js || true",
  "test:smoke": "cross-env ENV=staging cucumber-js --tags \"@smoke\" --config=config/cucumber.js || true",
  "test:regression": "cross-env ENV=staging cucumber-js --tags \"@regression\" --config=config/cucumber.js || true",
  "test:staging": "cross-env ENV=staging cucumber-js --config=config/cucumber.js || true",
  "test:sanity": "cross-env ENV=prod cucumber-js --config=config/cucumber.js || true"
},
  "keywords": [
    "cucumber",
    "cucumber - TS",
    "playwright-cucumber"
  ],
  "author": " Continental QA.....",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^9.0.1",
    "@playwright/test": "1.35.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "fs-extra": "^11.1.1",
    "multiple-cucumber-html-reporter": "^3.3.0",
    "ts-node": "^10.9.1",
    "winston": "^3.8.2"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
